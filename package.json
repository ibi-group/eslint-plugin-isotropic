{
    "author": "Steven Olmsted <steven.olmsted@ibigroup.com>",
    "bugs": "https://github.com/ibi-group/eslint-plugin-isotropic/issues",
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "~4.7.2",
        "@stylistic/eslint-plugin": "~5.10.0",
        "eslint": "~10.7.0",
        "eslint-plugin-import-x": "~4.17.1",
        "eslint-plugin-n": "~18.2.2",
        "eslint-plugin-promise": "~7.3.0",
        "eslint-plugin-regexp": "~3.1.1",
        "fs-extra": "~11.3.6",
        "globals": "~17.7.0",
        "isotropic-natural-sort": "~0.9.0"
    },
    "description": "ESLint rules for Isotropic",
    "devDependencies": {
        "eslint-plugin-eslint-plugin": "~7.4.2",
        "isotropic-dev-dependencies": "~0.4.0"
    },
    "engines": {
        "node": "^26.5.0",
        "npm": "^11.17.0"
    },
    "files": [
        "lib"
    ],
    "homepage": "https://github.com/ibi-group/eslint-plugin-isotropic",
    "keywords": [
        "eslint",
        "eslint-plugin",
        "eslintplugin",
        "isotropic",
        "lint",
        "plugin"
    ],
    "license": "BSD-3-Clause",
    "main": "lib/eslint-plugin-isotropic.js",
    "name": "eslint-plugin-isotropic",
    "repository": "github:ibi-group/eslint-plugin-isotropic",
    "scripts": {
        "lint": "eslint eslint.config.js lib test",
        "posttest": "c8 -c ./node_modules/isotropic-dev-dependencies/config/c8.json check-coverage",
        "prepare": "node ./node_modules/isotropic-dev-dependencies/lib/install-git-hooks.js",
        "prepublishOnly": "npm test",
        "pretest": "npm run lint",
        "test": "c8 -c ./node_modules/isotropic-dev-dependencies/config/c8.json node --test"
    },
    "type": "module",
    "version": "0.9.1"
